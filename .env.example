# ==============================================================================
# The Capital Market - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# ==============================================================================

# EmailJS Configuration (Required for Contact Form submissions)
# Create a free account at https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Site Information
NEXT_PUBLIC_SITE_NAME="The Capital Market"
NEXT_PUBLIC_SITE_URL="https://thecapitalmarket.in"

# Academy Contact Details
NEXT_PUBLIC_CONTACT_EMAIL="contact@example.com"
NEXT_PUBLIC_CONTACT_PHONE="+91 80 0000 0000"
NEXT_PUBLIC_CONTACT_LOCATION="Bangalore, India"

# Social Media Links
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com"
NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com"
NEXT_PUBLIC_TWITTER_URL="https://twitter.com"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com"
NEXT_PUBLIC_TELEGRAM_URL="https://telegram.org"
